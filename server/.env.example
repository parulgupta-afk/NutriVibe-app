# =================================================================
# NutriVibe Server Environment Variables
# Copy to server/.env and populate with your configuration.
# Never commit server/.env to version control.
# =================================================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
# For Atlas, ensure network access allows your IP or 0.0.0.0/0
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nutrivibe?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Client Application URL (CORS origin, no trailing slash)
CLIENT_URL=http://localhost:5173

# Generative AI & Explanations (Google Gemini Flash)
# When omitted, VibeAI operates in grounded offline fallback mode
GEMINI_API_KEY=

# Google OAuth 2.0 Sign-In (Must match client VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Email Delivery for Password Resets (Uses Ethereal testing account in development if empty)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587

# Redis Caching (Optional — in-memory cache fallback used if unset)
# REDIS_URL=redis://127.0.0.1:6379
