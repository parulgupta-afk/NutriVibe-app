# Copy to server/.env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Required
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nutrivibe?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# Required in production (CORS)
CLIENT_URL=http://localhost:5173

# Optional — AI ingredient explanations
GEMINI_API_KEY=

# Optional — Google Sign-In (must match client VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Optional — real email for password reset (otherwise Ethereal test inbox in dev)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
