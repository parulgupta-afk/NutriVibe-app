# Copy to server/.env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Required
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nutrivibe?retryWrites=true&w=majority

# Required — use a long random string. Production requires length >= 32 (not an example value).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Prefer shorter access lifetime in production (e.g. 1d or 12h). Default 7d is convenient for demos only.
JWT_EXPIRE=7d

# Required in production (CORS origin of the frontend, no trailing slash).
CLIENT_URL=http://localhost:5173

# Optional — AI ingredient explanations
GEMINI_API_KEY=

# Optional — Google Sign-In (must match client VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# Optional — password-reset email (otherwise Ethereal in dev)
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Optional — Redis product cache / shared rate limits
# REDIS_URL=redis://127.0.0.1:6379
