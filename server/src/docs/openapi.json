{
  "openapi": "3.0.3",
  "info": {
    "title": "NutriVibe API",
    "version": "1.0.0",
    "description": "Personalized food safety API. Matches the live Express routes — not a fictional catalog."
  },
  "servers": [
    { "url": "http://localhost:5000", "description": "Local" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string" },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": { "description": "API and Mongo status" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 6 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created with JWT" },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "JWT + user" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/products/barcode/{barcode}": {
      "get": {
        "summary": "Lookup product by barcode + safety report",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "barcode",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Product + safetyReport" },
          "404": { "description": "Not found" },
          "503": { "description": "Upstream OFF unavailable" }
        }
      }
    },
    "/api/products/{id}/alternatives": {
      "get": {
        "summary": "Personalized safer alternatives",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "alternatives array" }
        }
      }
    },
    "/api/products/{id}/explain": {
      "get": {
        "summary": "AI ingredient explanation (not a medical decision)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "explanation text" },
          "502": { "description": "Gemini unavailable" }
        }
      }
    },
    "/api/tracking/log": {
      "post": {
        "summary": "Log a product (supports Idempotency-Key header)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId"],
                "properties": {
                  "productId": { "type": "string" },
                  "action": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Log created" }
        }
      }
    },
    "/api/favorites": {
      "get": {
        "summary": "List saved products",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Saved products" } }
      }
    },
    "/api/dependents": {
      "get": {
        "summary": "List family profiles",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Dependents" } }
      }
    }
  }
}
