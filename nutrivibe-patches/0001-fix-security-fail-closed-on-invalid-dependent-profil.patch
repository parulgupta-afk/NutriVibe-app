From 5431af3c132990e2aacb14246d4f2ea49eb15c30 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 07:17:05 +0000
Subject: [PATCH 1/6] fix(security): fail closed on invalid dependent profile
 ids

resolveEffectiveUser silently fell back to the account owner's allergies and
medications when profileId was unknown, deleted, malformed or owned by another
user. For a dependent with an allergy this could produce a false SAFE verdict.
It now throws a uniform 404 (no ownership oracle), rejects non-string and
non-ObjectId values (operator injection), and has ownership tests.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016pR1EvpjQr4Y9EDsjFPn32
---
 server/src/services/profileResolver.js | 31 +++++++++++------
 server/tests/profileResolver.test.js   | 47 ++++++++++++++++++++++++++
 2 files changed, 67 insertions(+), 11 deletions(-)

diff --git a/server/src/services/profileResolver.js b/server/src/services/profileResolver.js
index 6570427..82eef13 100644
--- a/server/src/services/profileResolver.js
+++ b/server/src/services/profileResolver.js
@@ -1,27 +1,36 @@
+const mongoose = require('mongoose');
 const Dependent = require('../models/Dependent');
+const { AppError, Codes } = require('../errors/AppError');
 
 /**
  * Resolve which profile a scan/log request is actually for.
  *
- * If no profileId is given (or it doesn't belong to the requesting
- * user, or was deleted), we silently fall back to the account owner's
- * own preferences — a stale profileId should never break scanning.
+ * SAFETY: if a profileId is supplied it MUST resolve to a profile owned by the
+ * requesting user. We never fall back to the account owner's preferences,
+ * because a dependent's allergies/medications differ from the owner's and a
+ * silent fallback could yield a false "Safe" verdict. Malformed, unknown,
+ * deleted and other-user ids all produce the same 404 (no ownership oracle).
  *
- * Returns an object shaped like a User (has ._id and .preferences) so
- * it can be passed directly into computeSafetyVerdict without any
- * special-casing there.
+ * Returns an object shaped like a User (has ._id and .preferences) so it can be
+ * passed directly into computeSafetyVerdict.
  */
 async function resolveEffectiveUser(req) {
-  const profileId = req.query?.profileId || req.body?.profileId;
+  const rawId = req.query?.profileId ?? req.body?.profileId;
 
-  if (!profileId) {
+  if (rawId === undefined || rawId === null || rawId === '') {
     return { effectiveUser: req.user, profileId: null, profileName: null };
   }
 
-  const dependent = await Dependent.findOne({ _id: profileId, owner: req.user.id });
+  const notFound = () => new AppError('Profile not found', 404, Codes.NOT_FOUND);
 
+  // Reject non-strings (e.g. {"$ne":null} operator injection) and bad ObjectIds.
+  if (typeof rawId !== 'string' || !mongoose.isValidObjectId(rawId)) {
+    throw notFound();
+  }
+
+  const dependent = await Dependent.findOne({ _id: rawId, owner: req.user.id });
   if (!dependent) {
-    return { effectiveUser: req.user, profileId: null, profileName: null };
+    throw notFound();
   }
 
   return {
@@ -31,4 +40,4 @@ async function resolveEffectiveUser(req) {
   };
 }
 
-module.exports = { resolveEffectiveUser };
\ No newline at end of file
+module.exports = { resolveEffectiveUser };
diff --git a/server/tests/profileResolver.test.js b/server/tests/profileResolver.test.js
index 00e5208..aa371c8 100644
--- a/server/tests/profileResolver.test.js
+++ b/server/tests/profileResolver.test.js
@@ -34,3 +34,50 @@ describe('profileResolver unit tests', () => {
   });
 });
 
+
+describe('profileResolver ownership (fail closed, no silent owner fallback)', () => {
+  const Dependent = require('../src/models/Dependent');
+  const VALID = '64b7f0c2a1b2c3d4e5f60718';
+  const owner = { id: 'owner_1', preferences: { allergies: [] } };
+  let original;
+
+  const withFindOne = (impl) => {
+    original = Dependent.findOne;
+    Dependent.findOne = impl;
+  };
+  const restore = () => { Dependent.findOne = original; };
+
+  it('throws 404 when profileId does not belong to the user', async () => {
+    withFindOne(async (q) => { assert.equal(q.owner, 'owner_1'); return null; });
+    try {
+      await assert.rejects(
+        resolveEffectiveUser({ user: owner, query: { profileId: VALID }, body: {} }),
+        (e) => e.statusCode === 404 && e.code === 'NOT_FOUND'
+      );
+    } finally { restore(); }
+  });
+
+  it('throws 404 for malformed ids without querying the DB', async () => {
+    withFindOne(async () => { throw new Error('must not query'); });
+    try {
+      await assert.rejects(resolveEffectiveUser({ user: owner, query: { profileId: 'abc' }, body: {} }), (e) => e.statusCode === 404);
+    } finally { restore(); }
+  });
+
+  it('rejects operator-injection objects in profileId', async () => {
+    withFindOne(async () => { throw new Error('must not query'); });
+    try {
+      await assert.rejects(resolveEffectiveUser({ user: owner, query: {}, body: { profileId: { $ne: null } } }), (e) => e.statusCode === 404);
+    } finally { restore(); }
+  });
+
+  it('uses the dependent preferences (not the owner) when owned', async () => {
+    const prefs = { allergies: ['Peanuts'] };
+    withFindOne(async () => ({ _id: VALID, name: 'Aarav', preferences: prefs }));
+    try {
+      const r = await resolveEffectiveUser({ user: owner, query: { profileId: VALID }, body: {} });
+      assert.deepEqual(r.effectiveUser.preferences, prefs);
+      assert.equal(r.profileName, 'Aarav');
+    } finally { restore(); }
+  });
+});
