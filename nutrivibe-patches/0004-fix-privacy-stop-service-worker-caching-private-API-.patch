From 121815205b22dff0967580e1a7d475996adbe75f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 07:18:27 +0000
Subject: [PATCH 4/6] fix(privacy): stop service worker caching private API
 responses

sw.js persisted every successful GET under /api and /v1 (profiles, allergies,
medications, scan history) in Cache Storage, surviving logout on shared
devices. API calls are now network-only; offline returns an explicit JSON 503
(previously respondWith could receive undefined). Cache bumped to v4 so old
caches are purged on activate. Adds a vm-based test of the real sw.js.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016pR1EvpjQr4Y9EDsjFPn32
---
 client/public/sw.js                | 30 ++++++++++-----------
 client/tests/serviceWorker.test.js | 43 ++++++++++++++++++++++++++++++
 2 files changed, 58 insertions(+), 15 deletions(-)
 create mode 100644 client/tests/serviceWorker.test.js

diff --git a/client/public/sw.js b/client/public/sw.js
index 0450692..9297e53 100644
--- a/client/public/sw.js
+++ b/client/public/sw.js
@@ -1,5 +1,7 @@
-/* NutriVibe offline PWA — cache shell + recent API GETs (Phase 7 Option D) */
-const CACHE = 'nutrivibe-v3';
+/* NutriVibe offline PWA — caches the app shell and static assets ONLY.
+ * API responses contain private health data (allergies, medications, history)
+ * and must never be written to Cache Storage. */
+const CACHE = 'nutrivibe-v4';
 const PRECACHE = ['/', '/index.html', '/manifest.json', '/favicon.svg'];
 
 self.addEventListener('install', (e) => {
@@ -22,18 +24,16 @@ self.addEventListener('fetch', (e) => {
 
   const url = new URL(e.request.url);
 
-  // Network-first for API; cache-first for static
+  // API: network only, never cached. Offline -> explicit JSON 503 (never undefined).
   if (url.pathname.startsWith('/api') || url.pathname.startsWith('/v1')) {
     e.respondWith(
-      fetch(e.request)
-        .then((res) => {
-          if (e.request.method === 'GET' && res.ok) {
-            const clone = res.clone();
-            caches.open(CACHE).then((c) => c.put(e.request, clone));
-          }
-          return res;
-        })
-        .catch(() => caches.match(e.request))
+      fetch(e.request).catch(
+        () =>
+          new Response(
+            JSON.stringify({ success: false, message: 'You appear to be offline.' }),
+            { status: 503, headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' } }
+          )
+      )
     );
     return;
   }
@@ -53,9 +53,9 @@ self.addEventListener('fetch', (e) => {
     caches.match(e.request).then((hit) => {
       return (
         hit ||
-        fetch(e.request).catch(() => {
-          return caches.match('/index.html');
-        })
+        fetch(e.request).catch(
+          async () => (await caches.match('/index.html')) || new Response('', { status: 504 })
+        )
       );
     })
   );
diff --git a/client/tests/serviceWorker.test.js b/client/tests/serviceWorker.test.js
new file mode 100644
index 0000000..621882c
--- /dev/null
+++ b/client/tests/serviceWorker.test.js
@@ -0,0 +1,43 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+function load() {
+  const handlers = {};
+  const puts = [];
+  const cache = { put: (...a) => puts.push(a), addAll: async () => {} };
+  const sandbox = {
+    URL,
+    Response,
+    self: { addEventListener: (t, h) => (handlers[t] = h), skipWaiting() {}, clients: { claim() {} } },
+    caches: { open: async () => cache, match: async () => undefined, keys: async () => [], delete: async () => true },
+    fetch: async () => new Response('{"data":"private"}', { status: 200 }),
+  };
+  vm.runInNewContext(fs.readFileSync(new URL('../public/sw.js', import.meta.url), 'utf8'), sandbox);
+  return { handlers, puts, sandbox };
+}
+
+const run = (h, url, mode = 'cors') => {
+  let p;
+  h.fetch({ request: { url, method: 'GET', mode }, respondWith: (x) => (p = x) });
+  return p;
+};
+
+describe('service worker privacy', () => {
+  it('never writes API responses to Cache Storage', async () => {
+    const { handlers, puts } = load();
+    const res = await run(handlers, 'https://app.test/api/dependents');
+    assert.equal(res.status, 200);
+    await new Promise((r) => setTimeout(r, 10));
+    assert.equal(puts.length, 0);
+  });
+
+  it('returns a JSON 503 (not undefined) when the API is offline', async () => {
+    const { handlers, sandbox } = load();
+    sandbox.fetch = async () => { throw new TypeError('offline'); };
+    const res = await run(handlers, 'https://app.test/v1/check');
+    assert.equal(res.status, 503);
+    assert.equal(res.headers.get('Cache-Control'), 'no-store');
+  });
+});
