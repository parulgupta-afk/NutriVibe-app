From 4f4dd273b0278e13c15b2a24759504c9563056d5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 07:19:01 +0000
Subject: [PATCH 5/6] fix(security): CSP, body limits, Gemini key handling,
 image validation

- Helmet: deny-by-default CSP for the JSON API; scoped policy for /api/docs
- JSON body limit 100kb by default; 8mb only for /api/ai/* (image upload)
- Gemini: API key via x-goog-api-key header (not URL); bounded LRU-style
  cache (500); no full-response logging; product text delimited as untrusted
  data in the prompt; analyze-image validates mime allowlist and size

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_016pR1EvpjQr4Y9EDsjFPn32
---
 server/src/app.js                             | 20 +++++++++++--
 server/src/controllers/aiController.js        |  9 +++++-
 server/src/services/geminiExplainerService.js | 29 +++++++++++++++----
 3 files changed, 49 insertions(+), 9 deletions(-)

diff --git a/server/src/app.js b/server/src/app.js
index f0f6292..d7d9cc6 100644
--- a/server/src/app.js
+++ b/server/src/app.js
@@ -83,8 +83,18 @@ const aiLimiter = rateLimit({
 // Expose AI limiter to routes without circular requires
 app.locals.aiLimiter = aiLimiter;
 
+// This server returns JSON (the SPA is served by Vercel), so a locked-down CSP is
+// safe. /api/docs loads Swagger UI from unpkg and gets its own relaxed policy.
 app.use(helmet({
-  contentSecurityPolicy: false // SPA + camera; tighten later if you add a strict CSP
+  contentSecurityPolicy: {
+    useDefaults: false,
+    directives: {
+      defaultSrc: ["'none'"],
+      frameAncestors: ["'none'"],
+      baseUri: ["'none'"],
+      formAction: ["'none'"],
+    },
+  },
 }));
 app.use(compression());
 const allowedOrigins = [
@@ -107,7 +117,9 @@ app.use(cors({
 // Phase 4: production logs stay compact; never log bodies
 app.use(morgan(process.env.NODE_ENV === 'production' ? 'combined' : 'dev'));
 app.use(requestLogger);
-app.use(express.json({ limit: '8mb' }));
+// Default JSON limit is small; routes that accept images raise it explicitly.
+const bigJson = express.json({ limit: '8mb' });
+app.use((req, res, next) => (/^\/api\/(ai|meals)\//.test(req.path) ? bigJson(req, res, next) : express.json({ limit: '100kb' })(req, res, next)));
 app.use(express.urlencoded({ extended: true, limit: '1mb' }));
 app.use('/api', limiter);
 
@@ -153,6 +165,10 @@ app.get('/api/openapi.json', (req, res) => {
   res.json(openapi);
 });
 app.get('/api/docs', (req, res) => {
+  res.setHeader(
