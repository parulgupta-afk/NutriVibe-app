# =================================================================
# NutriVibe Client Environment Variables
# Copy to client/.env for local overrides.
# In production (e.g., Vercel, Render), set these in your dashboard.
# =================================================================

# Backend API Origin (No trailing slash)
# In local development, leave unset or commented out because Vite
# automatically proxies all /api requests to http://localhost:5000.
# VITE_API_BASE_URL=https://your-api.onrender.com

# Google Identity Services Client ID
# Must match server GOOGLE_CLIENT_ID for Google Sign-In verification.
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
