# Copy to client/.env for local overrides.
# In production (Vercel), set these in the project Environment Variables UI.

# Backend origin, no trailing slash. Leave empty in local dev (Vite proxies /api → :5000).
# VITE_API_BASE_URL=https://your-api.onrender.com

# Google Identity Services client ID (must match server GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
